{
  "name": "@sudobility/genui_rn",
  "version": "0.1.88",
  "description": "React Native renderer for IRenderable tree payloads",
  "type": "module",
  "main": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "generate:theme": "node scripts/generate-theme-css.cjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "jest --passWithNoTests",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "react-native",
    "render-tree",
    "typescript",
    "ui",
    "renderer"
  ],
  "author": "John Q Huang",
  "license": "BUSL-1.1",
  "packageManager": "bun@1.3.10",
  "peerDependencies": {
    "@react-native-community/slider": ">=4.0.0",
    "@sudobility/components-rn": "^1.0.129",
    "@sudobility/design": "^1.1.66",
    "@sudobility/genui_types": "^0.0.4",
    "clsx": "^2.0.0",
    "nativewind": ">=4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "react-native-maps": "^1.27.2",
    "react-native-webview": ">=13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@react-native-community/slider": "~4.5.7",
    "@react-native/babel-preset": "~0.77.3",
    "@sudobility/components-rn": "^1.0.129",
    "@sudobility/design": "^1.1.66",
    "@testing-library/jest-native": "~5.4.3",
    "@testing-library/react-native": "~13.3.3",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "ajv": "8",
    "clsx": "~2.1.1",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "jest": "~29.7.0",
    "nativewind": "~4.2.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-native": "~0.79.7",
    "react-native-webview": "~13.16.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.3",
    "vite": "~6.4.2",
    "vite-plugin-dts": "~4.5.4"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/genui_rn.git"
  }
}
